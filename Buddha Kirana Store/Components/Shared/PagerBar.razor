<div class="d-flex align-center justify-end flex-wrap pa-2" style="gap:12px;">
    <MudText Typo="Typo.body2">Rows per page</MudText>
    <MudSelect T="int" Value="PageSize" ValueChanged="OnPageSizeSelected" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:90px;">
        @foreach (var size in PageSizeOptions)
        {
            <MudSelectItem Value="@size">@size</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.body2">@RangeText</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" Disabled="@(Page <= 1)" OnClick="@(() => GoTo(1))" />
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(Page <= 1)" OnClick="@(() => GoTo(Page - 1))" />
    <MudText Typo="Typo.body2">Page @Page of @TotalPages</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(Page >= TotalPages)" OnClick="@(() => GoTo(Page + 1))" />
    <MudIconButton Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" Disabled="@(Page >= TotalPages)" OnClick="@(() => GoTo(TotalPages))" />
</div>

@code {
    /// <summary>Current page, 1-based.</summary>
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50, 100];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));

    private string RangeText => TotalCount == 0
        ? "0 of 0"
        : $"{(Page - 1) * PageSize + 1}-{Math.Min(Page * PageSize, TotalCount)} of {TotalCount}";

    private Task GoTo(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, TotalPages));

    private Task OnPageSizeSelected(int size) => PageSizeChanged.InvokeAsync(size);
}
